generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One table to hold the translation

enum Direction {
  SO_TO_EN
  EN_TO_SO
}

model Translation {
  id Int @id @default(autoincrement())
  sourceText String
  translatedText String?
  direction Direction
  createdAt DateTime @default(now())

  @@map("translations")
}